# ─────────────────────────────────────────────────────────────────────────────
# ACTUS-V2 — Environment Variables Template
# Copy this to apps/web/.env.local and fill in the values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon) ──────────────────────────────────────────────────────────
# Get from: neon.tech → your project → Connection string
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Clerk ────────────────────────────────────────────────────────────────────
# Get from: clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk redirect URLs (leave as-is for local dev)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ── Anthropic (Claude API) ───────────────────────────────────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-..."

# ── WhatsApp (ver docs/technical/08 para el set completo de Meta) ─────────────
# Número VISIBLE del bot en formato E.164 (solo dígitos), usado para los deep links
# wa.me de los QR de máquina. Para el piloto es el número del sandbox de Meta.
WHATSAPP_BOT_NUMBER="15556608866"

# ── Resend (landing contact form) ────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY="re_..."
# Where contact-form leads are delivered. While using the default sender
# (onboarding@resend.dev), this MUST be the email of your Resend account —
# Resend only delivers to that address until you verify a domain.
CONTACT_TO_EMAIL="tu-email@gmail.com"
# Optional — once you verify a domain in Resend, switch the sender:
# CONTACT_FROM_EMAIL="Actus <hola@actus.ai>"

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# URL pública del deploy, usada para armar links que terceros levantan desde afuera
# (imágenes del bot que descarga WhatsApp, link del email del resumen semanal).
# En prod seteala al dominio real; si no está, el código usa https://actusagent.io.
APP_PUBLIC_URL="https://actusagent.io"
NODE_ENV="development"
